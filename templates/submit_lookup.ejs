<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet"
    href="https://fonts.googleapis.com/css?family=Playfair+Display">
    <link rel = "stylesheet" href = "root.css">
    <link rel = "stylesheet" href = "submit_lookup.css">
    <title>Search results for "<%- keyword %>"</title>
</head>
<body>

    <div class="topnav">
      
