<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet"
    href="https://fonts.googleapis.com/css?family=Playfair+Display">
    <link rel = "stylesheet" href = "root.css">
    <link rel = "stylesheet" href = "review.css">
    <title>Submit Review</title>
  </head>
  <body>
    <div class="topnav">
      
      <div class="item-container">
  
          <div class ="item-container-1">
              <div class = "name">&nbsp;Book Review</div>
          </div>
          
          <div class ="item-container-2">
              <div class = "item item1"><a href ="/home">Home </a></div>
              <div class = "item item2"><a href = "/about">About</a></div>
          </div>  
       
      </div>
  </div>

  <div class = "main-container"> 
      <div class = "form-container"> 
          <center><h1>Submit a Book Review</h1></center>
          <form action="/submit_review" method="POST" class="form-box">
              <div class = "flex-container"> 

                  <div class ="item-1">
                      <label>Username:</label>
                      <input class="search-bar" type="text" name="name" required>
                      <br> 
                      <label>Email:</label>
                      <input class="search-bar"  type="email" name="email" required>
                  </div>
                 
                  <div class = "item-2"> 
                      <label>Title:</label>
                      <input class="search-bar" type="text" name="title" required>
                      <br>
                      <label class = "author">Author:</label>
                      <input class="search-bar" type="text" name="author" required />
                  </div>
              </div>

            
     
              <div class = "flex-container-2">
                  <label>Rating:</label>
                  <div class="star-rating">
                      
                      <input type="radio" name="rating" id="star5" value="5" required>
                      <label for="star5">★</label>

                      <input type="radio" name="rating" id="star4" value="4">
                      <label for="star4">★</label>
                      
                      <input type="radio" name="rating" id="star3" value="3">
                      <label for="star3">★</label>
                      
                      <input type="radio" name="rating" id="star2" value="2">
                      <label for="star2">★</label>
                     
                      <input type="radio" name="rating" id="star1" value="1" />
                      <label for="star1">★</label>
                     
                  </div>
                        

                  <div class ="review-container"> 
                      <label>Review:</label>
                      <textarea name="review" rows="5" required></textarea>
                  </div>
                  
                      <br>
                      <br>
                  
                  <div class = "btn-container"> 
                  <button class ="submit-btn" type="submit">Submit Review</button>
                  <button class="reset-btn" type="reset">Reset</button>
                  </div>
                  

               </div>
               

                </form>
                
              
             
      </div>
  </div>
    <script>
      window.onsubmit = () => {
        confirm(
          "Are you sure you want to submit your review?\nYou will not be able to change your information once submitted."
        );
      };
    </script>
  </body>
</html>
