<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel = "stylesheet" href = "root.css">
    <link rel = "stylesheet" href = "lookup.css">
    <title>Submit Review</title>
</head>
<body>
    <div class="topnav">
      
        <div class="item-container">
    
        <div class ="item-container-1">

           <div class = "name">&nbsp;Book Review Site </div>
        </div> 
    
        <div class ="item-container-2">
            <div class = "item item1"><a href ="/home">Home </a></div>
            <div class = "item item2"><a href = "/about">About</a></div>
        </div>   
        </div>
    
    </div>

    <div class = "main-container"> 
        <div class = "form-container"> 
            <center>
            <div class = text-container>
                <h1>Lookup a Review!</h1>
                <h2> Enter a book name or a user to find the associated reviews</h2>
                <form action="/lookup" method="POST">
                        <div>
                            <div>
                                <label class = "input-label"for="search"><b>Username or Book Title:</b></label>
                                <input class="search-bar" type="query" id="query" name="query" required>
                                <br><br>
                            </div>
                        </div>
                    <div>
                        <br>
                        <div class = "btn-container">
                            <div class = "submit-btn"><input class="btn-2" type="submit" value="Lookup Reviews"></div>
                            <div class = "reset-btn"><input class="btn-1" type="reset" value="Reset"></div>
                        </div>
                    </div>
                </form>
            </div>
             </center>
        </div>    
    </div>
</body>
<script>
    window.onsubmit = () => { confirm("Are you sure you want to submit your lookup request?"); };
</script>
</html>